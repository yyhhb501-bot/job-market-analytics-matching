# Reverse proxy for the production stack. Only Caddy publishes 80/443; the API
# and web containers stay on the internal network.
#
# PUBLIC_DOMAIN is injected by compose (e.g. app.example.com). For local testing
# set PUBLIC_DOMAIN=localhost and Caddy serves plain HTTP on :80.

{$PUBLIC_DOMAIN} {
	encode gzip zstd

	# Only versioned FastAPI routes go to the backend. Unversioned /api/login,
	# /api/proxy, /api/demo-match and /api/collector belong to Next.js.
	handle /api/v1/* {
		reverse_proxy api:8000
	}
	@health path /health /livez /readyz
	handle @health {
		reverse_proxy api:8000
	}
	# Scrape endpoint: restrict at the network/firewall layer in production.
	handle /metrics {
		reverse_proxy api:8000
	}
	handle /docs {
		reverse_proxy api:8000
	}
	handle /openapi.json {
		reverse_proxy api:8000
	}

	# Everything else is the Next.js app.
	handle {
		reverse_proxy web:3000
	}
}
