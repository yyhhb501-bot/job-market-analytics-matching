# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://jobuser:jobpass@localhost:5432/jobs
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000
AUTO_CREATE_TABLES=true

# ---------------------------------------------------------------------------
# Authentication / abuse prevention. REQUIRED for any public deployment:
# write endpoints then require the X-API-Key header.
# ---------------------------------------------------------------------------
API_KEY=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
MATCH_RATE_LIMIT_PER_MINUTE=10
# memory | redis | auto. Production with multiple API replicas should use redis.
RATE_LIMIT_BACKEND=auto
# Prometheus scrape endpoint at /metrics.
ENABLE_METRICS=true
# Optional bearer token; unset keeps /metrics open.
#METRICS_TOKEN=change-me-prometheus-bearer

# Local-collector import gateway (/api/v1/import/*). Uploaded jobs stay private
# to the device and are excluded from public search/stats. Device creation is
# guarded by API_KEY; no LinkedIn credentials are ever stored server-side.
ENABLE_IMPORT_GATEWAY=true

# ---------------------------------------------------------------------------
# Collector toggles. Everything risky/rate-limited is OFF by default.
# ---------------------------------------------------------------------------
ENABLE_ATS=true
ENABLE_USAJOBS=false
ENABLE_JOBSPY=false
ENABLE_SEEK=false
ENABLE_LINKEDIN=false
ENABLE_ADZUNA=false
ENABLE_REMOTEOK=false

# ---------------------------------------------------------------------------
# Adapter credentials / config
# ---------------------------------------------------------------------------
# USAJOBS requires an email + API key: https://developer.usajobs.gov/apirequest/
USAJOBS_EMAIL=
USAJOBS_API_KEY=

# Adzuna (phase 2): https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Path to the public ATS board tokens to poll.
ATS_COMPANIES_FILE=config/ats_companies.json

# ---------------------------------------------------------------------------
# Saved-search email alerts (optional). Matches are always stored; email needs
# SMTP configured here. Set ENABLE_EMAIL_ALERTS=true to actually send.
# ---------------------------------------------------------------------------
ENABLE_EMAIL_ALERTS=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
ALERT_FROM_EMAIL=
ALERT_FROM_NAME=Job Aggregator
# Used to build job links inside alert emails. In Docker use http://localhost:3000.
WEB_BASE_URL=http://localhost:3000
ENABLE_DIGEST_ALERTS=true

# Saved-search webhook delivery (POST JSON to each search's webhook_url).
# Off by default; enable deliberately. Private/loopback targets are blocked.
ENABLE_WEBHOOKS=false
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_MAX_JOBS=20
WEBHOOK_ALLOWED_HOSTS=
WEBHOOK_ALLOW_PRIVATE=false
WEBHOOK_SIGNING_SECRET=
# Jobs not seen for this many days are marked inactive by the sweep task.
STALE_JOB_DAYS=30
# Per-board missing sweep (full ATS board sources only)
BOARD_SWEEP_ENABLED=true
MISSING_RUN_THRESHOLD=3
# Hour the daily digest/sweep run, evaluated in TIMEZONE (default right after
# the 12:00 collection).
DIGEST_HOUR_UTC=12

# ---------------------------------------------------------------------------
# FX salary display + enrichment
# ---------------------------------------------------------------------------
FX_BASE_CURRENCY=USD
FX_RATES={"USD": 1.0, "AUD": 0.66, "EUR": 1.08, "GBP": 1.27, "CAD": 0.74, "NZD": 0.60}
ENRICHMENT_ENABLED=true

# ---------------------------------------------------------------------------
# Semantic matching. Default `local` needs no key (offline deterministic).
# Use `openai` (or `auto`) + LLM_API_KEY for real embeddings.
# ---------------------------------------------------------------------------
ENABLE_SEMANTIC_MATCH=true
LLM_PROVIDER=local
LLM_API_KEY=
LLM_MODEL=text-embedding-3-small
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=30
LLM_EMBEDDING_DIM=256

# Cross-encoder reranking for /match (local = offline heuristics)
ENABLE_RERANK=true
RERANK_PROVIDER=local
RERANK_API_KEY=
RERANK_MODEL=rerank-english-v3.0
RERANK_BASE_URL=https://api.jina.ai/v1
RERANK_TOP_K=50

# LLM-generated summaries (needs LLM_PROVIDER=openai + LLM_API_KEY)
ENABLE_LLM_SUMMARIES=false
LLM_SUMMARY_MODEL=gpt-4o-mini
LLM_SUMMARY_MAX_CHARS=6000

# ---------------------------------------------------------------------------
# Search backend. Leave as `postgres` for the built-in full-text search.
# Set to `opensearch` + URL for scale (the API falls back to PostgreSQL on error).
# ---------------------------------------------------------------------------
SEARCH_BACKEND=postgres
OPENSEARCH_URL=
OPENSEARCH_INDEX=jobs
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_TIMEOUT_SECONDS=10

# ---------------------------------------------------------------------------
# Task queue (Celery + Redis). CELERY_* default to REDIS_URL when empty.
# ---------------------------------------------------------------------------
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Scheduling: `daily` runs once a day at COLLECT_HOUR:COLLECT_MINUTE in TIMEZONE
# (default 12:00 Asia/Shanghai = Beijing noon). Set COLLECT_SCHEDULE=interval
# to run every COLLECT_INTERVAL_MINUTES instead.
TIMEZONE=Asia/Shanghai
COLLECT_SCHEDULE=daily
COLLECT_HOUR=12
COLLECT_MINUTE=0
COLLECT_INTERVAL_MINUTES=60

# Defaults used by the scheduled run / `enqueue --all`
COLLECT_KEYWORDS=
COLLECT_LOCATION=
COLLECT_COUNTRY=
COLLECT_RESULTS=100
# JobSpy sites (comma-separated): indeed, google, glassdoor, zip_recruiter, linkedin
COLLECT_SITES=indeed,google
# Per-source result caps, e.g. {"jobspy":300,"adzuna":500}
COLLECT_RESULTS_OVERRIDES=
# Hot occupations refreshed more often than the daily run
COLLECT_HOT_KEYWORDS=
COLLECT_HOT_INTERVAL_HOURS=3
ATS_INTERVAL_HOURS=6

# ---------------------------------------------------------------------------
# Politeness / networking
# ---------------------------------------------------------------------------
USER_AGENT=job-aggregator/0.1 (+contact: you@example.com)
HTTP_TIMEOUT_SECONDS=30
SEEK_REQUESTS_PER_MINUTE=10
DEFAULT_COUNTRIES=US,AU
