{
  "manifest_version": 3,
  "name": "领英定向职位采集（本地）",
  "version": "2.3.0",
  "description": "复用当前 Edge 领英登录态，按可验证覆盖队列读取职位并导出本地 JSON。",
  "permissions": [
    "scripting",
    "storage",
    "unlimitedStorage",
    "downloads",
    "activeTab",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "catalog.js",
        "core.js",
        "pacing.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost/admin/imports*",
        "http://127.0.0.1/admin/imports*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
