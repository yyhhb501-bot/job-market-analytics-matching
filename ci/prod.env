# CI fixture: fake but structurally valid production settings. Used to prove
# compose.prod.yml validates and the stack can boot without real secrets.
# Never use these values in a real deployment.
# Used by: docker compose -f compose.prod.yml --env-file ci/prod.env config
#          and ci/compose.smoke.yml (see the prod-smoke CI job).
ENVIRONMENT=production
IMAGE_TAG=ci-smoke

POSTGRES_USER=jobuser
POSTGRES_PASSWORD=ci-smoke-not-a-real-password
POSTGRES_DB=jobs
REDIS_PASSWORD=ci-smoke-not-a-real-redis-password

PUBLIC_DOMAIN=localhost
PUBLIC_API_URL=http://localhost

# check_production_settings requires explicit origins, a non-empty API key and
# AUTO_CREATE_TABLES=false when ENVIRONMENT=production.
CORS_ORIGINS=http://localhost
AUTO_CREATE_TABLES=false
API_KEY=ci-smoke-not-a-real-api-key
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
MATCH_RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_BACKEND=redis

ENABLE_METRICS=true
ENABLE_IMPORT_GATEWAY=true
WEB_BASE_URL=http://localhost

ENABLE_ATS=false
ENABLE_USAJOBS=false
ENABLE_JOBSPY=false
ENABLE_ADZUNA=false
ENABLE_REMOTEOK=false
ENABLE_SEEK=false
ENABLE_LINKEDIN=false

SEARCH_BACKEND=postgres
OPENSEARCH_URL=

ENABLE_WEBHOOKS=false
WEBHOOK_ALLOW_PRIVATE=false
WEBHOOK_ALLOWED_HOSTS=
WEBHOOK_SIGNING_SECRET=

STALE_JOB_DAYS=30
BOARD_SWEEP_ENABLED=false
MISSING_RUN_THRESHOLD=3
