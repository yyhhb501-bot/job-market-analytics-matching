# Production environment for compose.prod.yml. Copy to .env.prod and fill in.
# docker compose -f compose.prod.yml up -d --build
ENVIRONMENT=production

POSTGRES_USER=jobuser
POSTGRES_PASSWORD=CHANGE_ME_STRONG
POSTGRES_DB=jobs
DATABASE_URL=postgresql+psycopg://jobuser:CHANGE_ME_STRONG@postgres:5432/jobs
REDIS_URL=redis://redis:6379/0

# Must be explicit origins in production (no wildcard).
CORS_ORIGINS=https://app.example.com
AUTO_CREATE_TABLES=false

# REQUIRED: protects all saved-search endpoints.
API_KEY=CHANGE_ME_STRONG
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
MATCH_RATE_LIMIT_PER_MINUTE=10

# Public URLs used inside the app / emails / export links.
WEB_BASE_URL=https://app.example.com
PUBLIC_API_URL=https://api.example.com

# Collectors (see .env.example for the full list)
ENABLE_ATS=true
ENABLE_USAJOBS=false
ENABLE_JOBSPY=false
ENABLE_ADZUNA=false
ENABLE_REMOTEOK=false
ENABLE_SEEK=false
ENABLE_LINKEDIN=false

# Webhooks stay off unless you run trusted receivers.
ENABLE_WEBHOOKS=false
WEBHOOK_ALLOW_PRIVATE=false
WEBHOOK_ALLOWED_HOSTS=
WEBHOOK_SIGNING_SECRET=

STALE_JOB_DAYS=30
BOARD_SWEEP_ENABLED=true
MISSING_RUN_THRESHOLD=3
