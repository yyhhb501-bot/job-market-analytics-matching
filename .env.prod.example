# Production environment for compose.prod.yml. Copy to .env.prod and fill in.
#
#   docker compose -f compose.prod.yml --env-file .env.prod build
#   docker compose -f compose.prod.yml --env-file .env.prod up -d
#
# Required secrets (the stack refuses to start without them):
#   POSTGRES_PASSWORD, REDIS_PASSWORD, API_KEY
ENVIRONMENT=production
IMAGE_TAG=0.1.0

POSTGRES_USER=jobuser
POSTGRES_PASSWORD=CHANGE_ME_STRONG
POSTGRES_DB=jobs
# DATABASE_URL / REDIS_URL are derived inside compose.prod.yml; do not set them
# here (REDIS_URL includes the password and must match REDIS_PASSWORD below).
REDIS_PASSWORD=CHANGE_ME_REDIS

# Caddy terminates TLS for this domain and proxies /api/* to the API.
PUBLIC_DOMAIN=app.example.com
PUBLIC_API_URL=https://app.example.com

# Must be explicit origins in production (no wildcard).
CORS_ORIGINS=https://app.example.com
AUTO_CREATE_TABLES=false

# REQUIRED: protects write/admin endpoints.
API_KEY=CHANGE_ME_STRONG
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
MATCH_RATE_LIMIT_PER_MINUTE=10
# Shared limiter across API replicas. "redis" | "memory" | "auto".
RATE_LIMIT_BACKEND=redis

# Observability: Prometheus scrape endpoint at /metrics (restrict at the edge).
ENABLE_METRICS=true

# Local-collector import gateway (device-token authenticated, private data).
ENABLE_IMPORT_GATEWAY=true

# Public URLs used inside the app / emails / export links.
WEB_BASE_URL=https://app.example.com

# Collectors (see .env.example for the full list)
ENABLE_ATS=true
ENABLE_USAJOBS=false
ENABLE_JOBSPY=false
ENABLE_ADZUNA=false
ENABLE_REMOTEOK=false
ENABLE_SEEK=false
ENABLE_LINKEDIN=false

# Search: keep "postgres" unless the optional `search` profile is running.
SEARCH_BACKEND=postgres
OPENSEARCH_URL=

# Webhooks stay off unless you run trusted receivers.
ENABLE_WEBHOOKS=false
WEBHOOK_ALLOW_PRIVATE=false
WEBHOOK_ALLOWED_HOSTS=
WEBHOOK_SIGNING_SECRET=

STALE_JOB_DAYS=30
BOARD_SWEEP_ENABLED=true
MISSING_RUN_THRESHOLD=3
