# Server-side (SSR) API base URL. In Docker this is the api service.
API_BASE_URL=http://localhost:8000

# Browser-side API base URL used for plain download links (export).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Server-only API key. When the API sets API_KEY, the Next.js proxy route
# (app/api/proxy) forwards it. Never expose this to the browser.
API_KEY=
